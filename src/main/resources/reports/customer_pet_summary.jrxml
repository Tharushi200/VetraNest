<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="customer_pet_summary"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="c0d1e2f3-a4b5-4678-9012-3456789abcde">

    <parameter name="CLINIC_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["VetraNest Animal Hospital"]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
        SELECT 
            c.customer_id,
            c.name AS customer_name,
            c.phone,
            c.email,
            c.address,
            p.pet_code,
            p.pet_name,
            p.species,
            p.breed,
            p.gender
        FROM customers c
        LEFT JOIN pets p ON c.customer_id = p.customer_id
        ORDER BY c.name ASC, p.pet_name ASC
        ]]>
    </queryString>

    <field name="customer_id" class="java.lang.Integer"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="phone" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="address" class="java.lang.String"/>
    <field name="pet_code" class="java.lang.String"/>
    <field name="pet_name" class="java.lang.String"/>
    <field name="species" class="java.lang.String"/>
    <field name="breed" class="java.lang.String"/>
    <field name="gender" class="java.lang.String"/>

    <variable name="TOTAL_CUSTOMERS" class="java.lang.Integer" calculation="DistinctCount">
        <variableExpression><![CDATA[$F{customer_id}]]></variableExpression>
    </variable>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="68" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="60" backcolor="#1E1B4B" uuid="d1e2f3a4-b5c6-7d8e-9f0a-1b2c3d4e5f6a"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="16" y="8" width="380" height="22" forecolor="#FFFFFF" uuid="e2f3a4b5-c6d7-8e9f-0a1b-2c3d4e5f6a7b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[VetraNest | Client & Patient Directory]]></text>
            </staticText>
            <staticText>
                <reportElement x="16" y="32" width="380" height="16" forecolor="#A5B4FC" uuid="f3a4b5c6-d7e8-9f0a-1b2c-3d4e5f6a7b8c"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Active Pet Owners and Registered Companion Animals]]></text>
            </staticText>
            <textField pattern="yyyy-MM-dd">
                <reportElement x="410" y="10" width="130" height="18" forecolor="#E0E7FF" uuid="0a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + new java.text.SimpleDateFormat("yyyy-MM-dd").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="2" width="555" height="20" backcolor="#6C63FF" uuid="1b2c3d4e-5f6a-7b8c-9d0e-1f2a3b4c5d6e"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="8" y="2" width="120" height="18" forecolor="#FFFFFF" uuid="2c3d4e5f-6a7b-8c9d-0e1f-2a3b4c5d6e7f"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="135" y="2" width="85" height="18" forecolor="#FFFFFF" uuid="3d4e5f6a-7b8c-9d0e-1f2a-3b4c5d6e7f8a"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Phone]]></text>
            </staticText>
            <staticText>
                <reportElement x="225" y="2" width="120" height="18" forecolor="#FFFFFF" uuid="4e5f6a7b-8c9d-0e1f-2a3b-4c5d6e7f8a9b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Email / City]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="2" width="110" height="18" forecolor="#FFFFFF" uuid="5f6a7b8c-9d0e-1f2a-3b4c-5d6e7f8a9b0c"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Pet Name (Code)]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="2" width="85" height="18" forecolor="#FFFFFF" uuid="6a7b8c9d-0e1f-2a3b-4c5d-6e7f8a9b0c1d"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Species / Breed]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="21" backcolor="#F8FAFC" uuid="7b8c9d0e-1f2a-3b4c-5d6e-7f8a9b0c1d2e">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="8" y="2" width="120" height="16" uuid="8c9d0e1f-2a3b-4c5d-6e7f-8a9b0c1d2e3f"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="135" y="2" width="85" height="16" uuid="9d0e1f2a-3b4c-5d6e-7f8a-9b0c1d2e3f4a"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{phone}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="225" y="2" width="120" height="16" uuid="0e1f2a3b-4c5d-6e7f-8a9b-0c1d2e3f4a5b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{email} != null && !$F{email}.isEmpty() ? $F{email} : ($F{address} != null ? $F{address} : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="2" width="110" height="16" uuid="1f2a3b4c-5d6e-7f8a-9b0c-1d2e3f4a5b6c"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{pet_name} != null ? $F{pet_name} + " (" + $F{pet_code} + ")" : "No pets registered"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="465" y="2" width="85" height="16" uuid="2a3b4c5d-6e7f-8a9b-0c1d-2e3f4a5b6c7d"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{species} != null ? $F{species} + " - " + $F{breed} : "-"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="21" width="555" height="1" forecolor="#E2E8F0" uuid="3b4c5d6e-7f8a-9b0c-1d2e-3f4a5b6c7d8e"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="24" splitType="Stretch">
            <textField>
                <reportElement x="430" y="4" width="80" height="16" forecolor="#64748B" uuid="4c5d6e7f-8a9b-0c1d-2e3f-4a5b6c7d8e9f"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="510" y="4" width="30" height="16" forecolor="#64748B" uuid="5d6e7f8a-9b0c-1d2e-3f4a-5b6c7d8e9f0a"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
