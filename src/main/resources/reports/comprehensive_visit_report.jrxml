<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprehensive_visit_report"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="a8b7c6d5-e4f3-2109-8765-43210fedcba9">

    <!-- Dynamic Parameters -->
    <parameter name="REPORT_TITLE" class="java.lang.String">
        <defaultValueExpression><![CDATA["VetraNest - Comprehensive Clinical Visits & Appointments Report"]]></defaultValueExpression>
    </parameter>
    <parameter name="CLINIC_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["VetraNest Animal Hospital & Pet Care"]]></defaultValueExpression>
    </parameter>
    <parameter name="CLINIC_CONTACT" class="java.lang.String">
        <defaultValueExpression><![CDATA["No. 124, Havelock Road, Colombo 05 | +94 11 234 5678 | info@vetranest.lk"]]></defaultValueExpression>
    </parameter>

    <!-- 4-Table JOIN SQL Query -->
    <queryString>
        <![CDATA[
        SELECT 
            a.appointment_id,
            a.appointment_date,
            a.time_slot,
            a.service_type,
            a.status,
            c.name AS customer_name,
            c.phone AS customer_phone,
            p.pet_name,
            p.species,
            COALESCE(t.diagnosis, 'Pending Visit') AS diagnosis,
            COALESCE(t.medication, 'None') AS medication
        FROM appointments a
        JOIN customers c ON a.customer_id = c.customer_id
        JOIN pets p ON a.pet_id = p.pet_id
        LEFT JOIN treatments t ON a.appointment_id = t.appointment_id
        ORDER BY a.appointment_date DESC, a.appointment_id DESC
        ]]>
    </queryString>

    <!-- Fields -->
    <field name="appointment_id" class="java.lang.Integer"/>
    <field name="appointment_date" class="java.sql.Date"/>
    <field name="time_slot" class="java.lang.String"/>
    <field name="service_type" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="customer_phone" class="java.lang.String"/>
    <field name="pet_name" class="java.lang.String"/>
    <field name="species" class="java.lang.String"/>
    <field name="diagnosis" class="java.lang.String"/>
    <field name="medication" class="java.lang.String"/>

    <variable name="TOTAL_RECORDS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{appointment_id}]]></variableExpression>
    </variable>

    <background>
        <band splitType="Stretch"/>
    </background>

    <!-- Title Section -->
    <title>
        <band height="75" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="68" backcolor="#1E1B4B" uuid="b1a2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="10" width="500" height="26" forecolor="#FFFFFF" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5c6e"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[VetraNest | Comprehensive Patient & Visit Report]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="38" width="500" height="18" forecolor="#A5B4FC" uuid="e2f3a4b5-c6d7-8e9f-0a1b-2c3d4e5f6a7b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CLINIC_CONTACT}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd HH:mm">
                <reportElement x="580" y="14" width="200" height="20" forecolor="#E0E7FF" uuid="f3a4b5c6-d7e8-9f0a-1b2c-3d4e5f6a7b8c"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="580" y="36" width="200" height="20" forecolor="#10B981" uuid="0a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[NIBM EAD 1 Coursework Report]]></text>
            </staticText>
        </band>
    </title>

