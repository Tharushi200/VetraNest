<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="pet_history_report"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="b9c8d7e6-f5a4-3210-9876-543210fedcba">

    <parameter name="PET_ID" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[0]]></defaultValueExpression>
    </parameter>
    <parameter name="CLINIC_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["VetraNest Animal Hospital"]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
        SELECT 
            t.treatment_id,
            t.treatment_date,
            t.diagnosis,
            t.medication,
            t.instructions,
            t.doctor_name,
            p.pet_code,
            p.pet_name,
            p.species,
            p.breed,
            p.weight,
            c.name AS owner_name,
            c.phone AS owner_phone
        FROM treatments t
        JOIN pets p ON t.pet_id = p.pet_id
        JOIN customers c ON p.customer_id = c.customer_id
        WHERE ($P{PET_ID} = 0 OR t.pet_id = $P{PET_ID})
        ORDER BY t.treatment_date DESC, t.treatment_id DESC
        ]]>
    </queryString>

    <field name="treatment_id" class="java.lang.Integer"/>
    <field name="treatment_date" class="java.sql.Date"/>
    <field name="diagnosis" class="java.lang.String"/>
    <field name="medication" class="java.lang.String"/>
    <field name="instructions" class="java.lang.String"/>
    <field name="doctor_name" class="java.lang.String"/>
    <field name="pet_code" class="java.lang.String"/>
    <field name="pet_name" class="java.lang.String"/>
    <field name="species" class="java.lang.String"/>
    <field name="breed" class="java.lang.String"/>
    <field name="weight" class="java.lang.Double"/>
    <field name="owner_name" class="java.lang.String"/>
    <field name="owner_phone" class="java.lang.String"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="70" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="64" backcolor="#1E1B4B" uuid="c2d3e4f5-a6b7-8c9d-0e1f-2a3b4c5d6e7f"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="16" y="8" width="380" height="24" forecolor="#FFFFFF" uuid="d3e4f5a6-b7c8-9d0e-1f2a-3b4c5d6e7f8a"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[VetraNest | Pet Clinical Medical History]]></text>
            </staticText>
            <staticText>
                <reportElement x="16" y="34" width="380" height="18" forecolor="#A5B4FC" uuid="e4f5a6b7-c8d9-0e1f-2a3b-4c5d6e7f8a9b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Official Veterinary Diagnosis & Prescription Transcript]]></text>
            </staticText>
            <textField pattern="yyyy-MM-dd HH:mm">
                <reportElement x="400" y="12" width="145" height="18" forecolor="#E0E7FF" uuid="f5a6b7c8-d9e0-1f2a-3b4c-5d6e7f8a9b0c"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + new java.text.SimpleDateFormat("yyyy-MM-dd").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="26" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="2" width="555" height="22" backcolor="#10B981" uuid="0a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="8" y="4" width="70" height="18" forecolor="#FFFFFF" uuid="1b2c3d4e-5f6a-7b8c-9d0e-1f2a3b4c5d6e"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="4" width="95" height="18" forecolor="#FFFFFF" uuid="2c3d4e5f-6a7b-8c9d-0e1f-2a3b4c5d6e7f"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Pet / Species]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="4" width="85" height="18" forecolor="#FFFFFF" uuid="3d4e5f6a-7b8c-9d0e-1f2a-3b4c5d6e7f8a"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Owner]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="4" width="115" height="18" forecolor="#FFFFFF" uuid="4e5f6a7b-8c9d-0e1f-2a3b-4c5d6e7f8a9b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Diagnosis]]></text>
            </staticText>
            <staticText>
                <reportElement x="390" y="4" width="160" height="18" forecolor="#FFFFFF" uuid="5f6a7b8c-9d0e-1f2a-3b4c-5d6e7f8a9b0c"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Medication & Doctor]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="36" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="35" backcolor="#F8FAFC" uuid="6a7b8c9d-0e1f-2a3b-4c5d-6e7f8a9b0c1d">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <textField pattern="yyyy-MM-dd">
                <reportElement x="8" y="2" width="70" height="16" uuid="7b8c9d0e-1f2a-3b4c-5d6e-7f8a9b0c1d2e"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{treatment_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="2" width="95" height="16" uuid="8c9d0e1f-2a3b-4c5d-6e7f-8a9b0c1d2e3f"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{pet_name} + " (" + $F{species} + ")"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="18" width="95" height="14" forecolor="#64748B" uuid="9d0e1f2a-3b4c-5d6e-7f8a-9b0c1d2e3f4a"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{breed} + " | " + $F{weight} + "kg"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="2" width="85" height="16" uuid="0e1f2a3b-4c5d-6e7f-8a9b-0c1d2e3f4a5b"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{owner_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="18" width="85" height="14" forecolor="#64748B" uuid="1f2a3b4c-5d6e-7f8a-9b0c-1d2e3f4a5b6c"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{owner_phone}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="2" width="115" height="30" uuid="2a3b4c5d-6e7f-8a9b-0c1d-2e3f4a5b6c7d"/>
                <textElement verticalAlignment="Top">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{diagnosis}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="390" y="2" width="160" height="16" uuid="3b4c5d6e-7f8a-9b0c-1d2e-3f4a5b6c7d8e"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{medication}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="390" y="18" width="160" height="14" forecolor="#475569" uuid="4c5d6e7f-8a9b-0c1d-2e3f-4a5b6c7d8e9f"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Vet: " + $F{doctor_name}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="35" width="555" height="1" forecolor="#E2E8F0" uuid="5d6e7f8a-9b0c-1d2e-3f4a-5b6c7d8e9f0a"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="24" splitType="Stretch">
            <textField>
                <reportElement x="430" y="4" width="80" height="16" forecolor="#64748B" uuid="6e7f8a9b-0c1d-2e3f-4a5b-6c7d8e9f0a1b"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="510" y="4" width="30" height="16" forecolor="#64748B" uuid="7f8a9b0c-1d2e-3f4a-5b6c-7d8e9f0a1b2c"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
